# Circle Developer-Controlled Wallets
# Get both from console.circle.com -> API & Client Keys
CIRCLE_API_KEY=
# Generate via Circle's registerEntitySecretCiphertext flow — required in
# addition to the API key for wallet/transaction calls. See:
# https://developers.circle.com/w3s/developer-controlled-create-your-first-wallet
CIRCLE_ENTITY_SECRET=
# Create a wallet set first (via console or API), then paste its id here
CIRCLE_WALLET_SET_ID=

# Circle Gateway / Nanopayments
CIRCLE_GATEWAY_API_BASE=https://gateway-api.circle.com

# Arc Testnet — confirmed from docs.arc.io/arc/references/connect-to-arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# USDC is a native system contract on Arc, not a standard ERC-20 deployment
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Groq — get from console.groq.com
GROQ_API_KEY=

# Supabase (service role key — server-side only, never expose to frontend)
# Get both from your Supabase project's Settings -> API page
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
